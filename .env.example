WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEEKLY_TEMPLATE=
BRAPI_TOKEN=
CRON_SECRET=
