# Copie para .env.local e preencha. NUNCA commite valores reais.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # só server-side; nunca com prefixo NEXT_PUBLIC_
NEXT_PUBLIC_SITE_URL=               # ex.: http://localhost:3000 (local) / https://seu-app.vercel.app

# --- a partir da fase do WhatsApp ---
AI_PROVIDER=openai
AI_MODEL=
