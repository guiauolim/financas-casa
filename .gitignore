# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — nunca commitar segredos; só o .env.example (sem valores)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase (a CLI também tem supabase/.gitignore)
supabase/.temp/
supabase/.branches/

# planilhas, extratos e faturas (dados financeiros reais nunca entram no repo público);
# exceção só para as fixtures FICTÍCIAS dos testes dos importadores
*.xlsx
*.xls
*.csv
*.ofx
*.pdf
!src/lib/importers/__fixtures__/b3-posicao-ficticia.xlsx
!src/lib/importers/__fixtures__/itau-fatura-ficticia-*.xlsx
!src/lib/importers/__fixtures__/itau-fatura-ficticia.xls
